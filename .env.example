# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model override (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Server-side refusal fallback: "default" (on) or "off"
# ANTHROPIC_FALLBACKS=default

# Optional delivery – ONLY to yourself. Leave empty to disable.
# DELIVERY=telegram,email
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=          # your own chat id with the bot
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_TO=                  # single address: your own

# Optional: output directory (default ./output)
# OUTPUT_DIR=output
